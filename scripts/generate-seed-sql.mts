// Generates supabase/seed.sql from the TypeScript seed (src/data/seed.ts + seed-settings.ts).
// Run: npm run seed:sql   (Node 24 runs TypeScript directly.)
import { writeFileSync } from 'node:fs';
import { dirname, join } from 'node:path';
import { fileURLToPath } from 'node:url';
import { seedCompounds, seedUnits, seedId } from '../src/data/seed.ts';
import { seedSettings, seedStory } from '../src/data/seed-settings.ts';

const root = join(dirname(fileURLToPath(import.meta.url)), '..');

type Value = string | number | boolean | null | undefined | string[] | number[] | object;

function lit(v: Value): string {
  if (v === null || v === undefined) return 'null';
  if (typeof v === 'number') return Number.isFinite(v) ? String(v) : 'null';
  if (typeof v === 'boolean') return v ? 'true' : 'false';
  if (Array.isArray(v)) {
    if (v.every((x) => typeof x === 'number')) return `'{${v.join(',')}}'`;
    return `array[${v.map((x) => lit(x as string)).join(', ')}]::text[]`;
  }
  if (typeof v === 'object') return `${lit(JSON.stringify(v))}::jsonb`;
  return `'${v.replace(/'/g, "''")}'`;
}

function insert(table: string, rows: Record<string, Value>[]): string {
  if (!rows.length) return '';
  const cols = Object.keys(rows[0]);
  const values = rows.map((r) => `  (${cols.map((c) => lit(r[c])).join(', ')})`).join(',\n');
  return `insert into public.${table} (${cols.join(', ')}) values\n${values};\n`;
}

const sql: string[] = [
  '-- Generated by scripts/generate-seed-sql.mts from src/data/seed.ts — do not edit by hand.',
  '-- Listings as seen on Nawy, October 2026. Romany must re-check availability and prices before launch.',
  'begin;',
  'delete from public.unit_photos; delete from public.compound_photos; delete from public.units; delete from public.compounds;',
  'delete from public.story_items; delete from public.settings;',
];

sql.push(
  insert(
    'compounds',
    seedCompounds.map((c) => ({
      id: c.id, slug: c.slug, name: c.name, name_ar: c.nameAr, developer: c.developer, location: c.location,
      location_ar: c.locationAr, area: c.area, mode: c.mode, unit_types: c.unitTypes, price_from: c.priceFrom,
      resale_price_from: c.resalePriceFrom, down_payment_min_pct: c.downPaymentMinPct, max_years: c.maxYears,
      finishing: c.finishing, master_plan_acres: c.masterPlanAcres, description_en: c.descriptionEn,
      description_ar: c.descriptionAr, consultant_note: c.consultantNote, consultant_note_ar: c.consultantNoteAr,
      amenities: c.amenities, amenities_ar: c.amenitiesAr, lat: c.lat, lng: c.lng, featured: c.featured,
      sort: c.sort, status: c.status, source_checked_at: c.sourceCheckedAt,
    })),
  ),
  insert(
    'compound_photos',
    seedCompounds.flatMap((c) => c.photos.map((p) => ({ id: p.id, parent_id: c.id, path: p.path, label: p.label, sort: p.sort, credit: p.credit }))),
  ),
  insert(
    'units',
    seedUnits.map((u) => ({
      id: u.id, slug: u.slug, compound_id: u.compoundId, project: u.project, sale_type: u.saleType, unit_type: u.unitType, beds: u.beds,
      baths: u.baths, size_m2: u.sizeM2, garden_m2: u.gardenM2, terrace_m2: u.terraceM2, land_m2: u.landM2,
      price: u.price, price_max: u.priceMax, down_payment_amount: u.downPaymentAmount,
      down_payment_pct: u.downPaymentPct, installment_amount: u.installmentAmount,
      installment_frequency: u.installmentFrequency, installment_years: u.installmentYears, delivery: u.delivery,
      finishing: u.finishing, floor: u.floor, cash_only: u.cashOnly, consultant_note: u.consultantNote,
      consultant_note_ar: u.consultantNoteAr, featured: u.featured, status: u.status,
      listing_status: u.listingStatus, sort: u.sort,
    })),
  ),
  insert(
    'unit_photos',
    seedUnits.flatMap((u) => u.photos.map((p) => ({ id: p.id, parent_id: u.id, path: p.path, label: p.label, sort: p.sort, credit: p.credit }))),
  ),
  insert(
    'story_items',
    seedStory.map((s) => ({ id: seedId(s.id), year: s.year, title: s.title, title_ar: s.titleAr, text: s.text, text_ar: s.textAr, sort: s.sort })),
  ),
  insert('settings', [
    {
      id: 1, consultant_name: seedSettings.consultantName, consultant_name_ar: seedSettings.consultantNameAr,
      title: seedSettings.title, title_ar: seedSettings.titleAr, portrait_path: seedSettings.portraitPath,
      avatar_path: seedSettings.avatarPath, phone: seedSettings.phone, whatsapp: seedSettings.whatsapp,
      email: seedSettings.email, hours: seedSettings.hours, hours_ar: seedSettings.hoursAr,
      open_days: seedSettings.openDays, open_from: seedSettings.openFrom, open_to: seedSettings.openTo,
      available: seedSettings.available, areas: seedSettings.areas, areas_ar: seedSettings.areasAr,
      social: seedSettings.social, story_intro: seedSettings.storyIntro, story_intro_ar: seedSettings.storyIntroAr,
      quote: seedSettings.quote, quote_ar: seedSettings.quoteAr,
    },
  ]),
  'commit;',
);

writeFileSync(join(root, 'supabase/seed.sql'), sql.filter(Boolean).join('\n'));
console.log(`seed.sql: ${seedCompounds.length} compounds, ${seedUnits.length} units`);
