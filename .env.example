# Public site URL (used for absolute links in emails, WhatsApp messages, sitemap and Open Graph)
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by server actions to store leads/chats/bookings after validation. Never expose it.
SUPABASE_SERVICE_ROLE_KEY=

# Salt for hashing visitor IPs in the rate limiter (any random string)
RATE_LIMIT_SALT=change-me

# Optional: email notifications for every new lead/booking via Resend (https://resend.com)
RESEND_API_KEY=
NOTIFY_EMAIL_TO=romany@example.com
NOTIFY_EMAIL_FROM="Baytak <hello@your-domain.com>"

# Optional: Telegram bot notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
